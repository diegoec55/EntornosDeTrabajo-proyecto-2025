<%- include('partials/header.ejs') %>
<div class="user-all py-10 px-4 sm:px-6 lg:px-8">

    <h1 class="user-title text-3xl font-semibold text-center mb-6" style="font-family: 'tan-mon-cheri';">Nuestros Usuarios</h1>
    <div class="text-center mb-6">
        <a href="/usuarios/nuevo" class="inline-block px-6 py-3 bg-gray-600 text-white font-semibold text-lg rounded-lg shadow-md hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-opacity-50">
            Agregar usuario
        </a>
    </div>

    <div class="cardAllUsers grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% usuarios.forEach(usuario => { %>
            <% if (usuario.disponible) { %>
                <div class="cardUser bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition duration-200 ease-in-out">
                    <a href="/usuarios/perfil/<%= usuario.id %>" class="text-xl font-semibold text-gray-600 hover:text-gray-800">
                        <h3 class="truncate"><%= usuario.first_name %> <%= usuario.last_name %></h3>
                    </a>
                    <div class="mt-2 text-gray-600">
                        <p><%= usuario.email %></p>
                    </div>
                </div>
            <% } %>
        <% }) %>
    </div>
</div>

<%- include('partials/footer.ejs') %>
