<%- include('partials/header.ejs') %>

<div class="py-10 px-4 sm:px-6 lg:px-8">
    <h2 class="text-2xl sm:text-3xl font-semibold text-center mb-6" style="font-family: 'tan-mon-cheri';">Nuevo Usuario</h2>
    
    <form class="formNew space-y-6 max-w-lg mx-auto p-6 rounded-lg shadow-lg" style="background-color: #e7e4e1;" action="/usuarios/nuevo" method="post">

        <div>
            <label for="name" class="block text-sm font-medium text-gray-700">Nombre:</label>
            <input id="name" name="name" type="text" class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#E2BE9F] focus:border-[#E2BE9F]" required>
        </div>

        <div>
            <label for="lastname" class="block text-sm font-medium text-gray-700">Apellido:</label>
            <input id="lastname" name="lastname" type="text" class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#E2BE9F] focus:border-[#E2BE9F]" required>
        </div>

        <div>
            <label for="email" class="block text-sm font-medium text-gray-700">Email:</label>
            <input id="email" name="email" type="text" class="mt-2 block w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-[#E2BE9F] focus:border-[#E2BE9F]" required>
        </div>

        <div class="flex items-center space-x-2">
            <input type="checkbox" id="disponible" name="disponible" checked class="h-5 w-5 accent-[#d47734] text-gray-600 focus:ring-[#E2BE9F] border-gray-300 rounded">
            <label for="disponible" class="text-sm text-gray-700">Disponible</label>
        </div>

        <div class="flex justify-center">
            <button type="submit" class="px-6 py-3 mt-6 bg-[#d47734] text-white font-semibold text-lg rounded-lg shadow-md hover:bg-[#A85922] focus:outline-none focus:ring-2 focus:ring-[#E2BE9F] focus:ring-opacity-50">
                Enviar
            </button>
        </div>
    </form>
</div>

<%- include('partials/footer.ejs') %>
